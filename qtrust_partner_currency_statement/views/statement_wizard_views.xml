<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_currency_statement_wizard_form" model="ir.ui.view">
        <field name="name">qtrust.partner.currency.statement.wizard.form</field>
        <field name="model">qtrust.partner.currency.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Foreign Currency Statement">
                <group>
                    <group>
                        <field name="partner_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="currency_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_partner_currency_statement" model="ir.actions.act_window">
        <field name="name">Foreign Currency Statement</field>
        <field name="res_model">qtrust.partner.currency.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_currency_statement_wizard_form"/>
        <field name="target">new</field>
    </record>
    <record id="action_partner_currency_statement_interactive" model="ir.actions.client">
        <field name="name">Foreign Currency Statement</field>
        <field name="tag">qtrust_partner_currency_statement.interactive</field>
    </record>
    <menuitem id="menu_partner_currency_statement"
              name="Foreign Currency Statement"
              parent="account.menu_finance_reports"
              action="action_partner_currency_statement_interactive"
              groups="account.group_account_user"
              sequence="95"/>
</odoo>
